      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="hand_joint" type="fixed">
    <origin rpy="0 0 1.57" xyz="0 0.1 -0.07"/>
    <parent link="base_link"/>
    <child link="hand_base_link"/>
  </joint>

