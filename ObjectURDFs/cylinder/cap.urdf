<?xml version="1.0" ?>
<robot name="cap.urdf">

  <link name="cap">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cylinder/cap_conicaltube050.obj" scale="0.001 0.001 0.001"/>

      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cylinder/cap_conicaltube050.stl" scale="0.0007 0.0007 0.0007"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>

  <link name="cap_tip" />
  
  <joint name="cap_tip_joint" type="fixed">
    <parent link="cap"/>
    <child link="cap_tip"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

</robot>
